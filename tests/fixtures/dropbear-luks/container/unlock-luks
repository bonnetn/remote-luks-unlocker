#!/bin/sh
set -eu

state_file=/var/lib/luks-test/state
expected_passphrase=${LUKS_PASSPHRASE:-test-passphrase}

case "${1:-status}" in
    status)
        cat "$state_file"
        ;;
    unlock)
        if [ "$(cat "$state_file")" = UNLOCKED ]; then
            echo UNLOCKED
            exit 0
        fi
        IFS= read -r passphrase
        if [ "$passphrase" != "$expected_passphrase" ]; then
            echo "invalid unlock password" >&2
            exit 1
        fi
        printf '%s\n' UNLOCKED >"$state_file"
        echo UNLOCKED
        ;;
    lock)
        printf '%s\n' LOCKED >"$state_file"
        cat "$state_file"
        ;;
    *)
        echo "usage: unlock-luks {status|unlock|lock}" >&2
        exit 2
        ;;
esac
