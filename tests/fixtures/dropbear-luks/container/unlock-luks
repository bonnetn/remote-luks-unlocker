#!/bin/sh
set -eu

volume_image=/var/lib/luks-test/luks-volume.img
mapper_name=luks_test

case "${1:-status}" in
    status)
        if cryptsetup status "$mapper_name" >/dev/null 2>&1; then
            echo UNLOCKED
        else
            echo LOCKED
        fi
        ;;
    unlock)
        if cryptsetup status "$mapper_name" >/dev/null 2>&1; then
            echo UNLOCKED
            exit 0
        fi
        printf 'LUKS passphrase: ' >&2
        IFS= read -r passphrase
        printf '%s' "$passphrase" | cryptsetup open "$volume_image" "$mapper_name" --key-file -
        echo UNLOCKED
        ;;
    lock)
        cryptsetup close "$mapper_name" 2>/dev/null || true
        echo LOCKED
        ;;
    *)
        echo "usage: unlock-luks {status|unlock|lock}" >&2
        exit 2
        ;;
esac
